# Copy to .env, choose a private password, then export it as described in docs/getting-started.md.
# This file uses shell-compatible assignments. Quote values containing spaces or shell characters.
DB_DATABASE=fitnutri
DB_USERNAME=fitnutri
DB_PASSWORD=CHANGE_ME
DB_PORT=5432
DB_URL=jdbc:postgresql://127.0.0.1:5432/fitnutri
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_BOOTSTRAP_ADMIN_ENABLED=false
REFERENCE_SOURCE_DIR=.local/reference-sources
IMPORT_FOOD_CATALOGUE=false
IMPORT_ACTIVITY_CATALOGUE=false
IMPORT_FOOD_SEARCH_METADATA=false
IMPORT_EXERCISE_OPTIONS=false
ACTIVITY_MANIFEST=data/manifests/compendium-2024-r2.json
AI_IMAGE_ENABLED=false
AI_TRANSCRIPTION_ENABLED=false
AI_PARSING_ENABLED=false
AI_QA_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_PARSING_MODEL=
OPENAI_QA_MODEL=
FFMPEG_BIN=ffmpeg
