{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "incremental": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true
  },
  "include": [
    "src",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": [
    "tests/legacy-demo"
  ]
}
