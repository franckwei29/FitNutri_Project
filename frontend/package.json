{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check:production": "node ../scripts/check-production-boundaries.mjs",
    "test:boundaries": "node --test ../scripts/tests/production-boundaries.test.mjs",
    "postbuild": "npm run check:production",
    "test:legacy": "node --experimental-strip-types --test tests/legacy-demo/tests/*.test.ts",
    "typecheck:legacy": "tsc -p tests/legacy-demo/tsconfig.json --noEmit",
    "pretest:legacy": "node --test ../scripts/tests/legacy-fixture-integrity.test.mjs",
    "test:fault-proxy": "node --test ../scripts/tests/e2e-fault-proxy.test.mjs",
    "dev:e2e-fault": "vite --config tests/e2e/vite-fault.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.102.4",
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "4.1.12"
  }
}
